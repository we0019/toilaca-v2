---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import runningData from "@/data/running/activities.json";

type RunningActivity = {
  startDate: string;
  distanceKm: number | null;
  durationSeconds: number | null;
};

const currentYear = new Date().getFullYear();
const activities = (runningData.activities as RunningActivity[]).filter(
  activity => activity.startDate.startsWith(String(currentYear))
);
const totalDistance = activities.reduce(
  (sum, activity) => sum + (activity.distanceKm ?? 0),
  0
);
const totalDuration = activities.reduce(
  (sum, activity) => sum + (activity.durationSeconds ?? 0),
  0
);
const averagePace =
  totalDistance > 0 && totalDuration > 0
    ? Math.round(totalDuration / totalDistance)
    : null;
const latestActivity = activities[0];
const lastSyncedAt = runningData.lastSyncedAt
  ? formatDateTime(runningData.lastSyncedAt)
  : null;

const weeklyDistance = getRecentWeeklyDistance(activities);
const maxWeeklyDistance = Math.max(
  1,
  ...weeklyDistance.map(week => week.distanceKm)
);
const chartWidth = 800;
const chartHeight = 240;
const chartPadding = {
  top: 32,
  right: 48,
  bottom: 44,
  left: 48,
};
const chartPlotWidth = chartWidth - chartPadding.left - chartPadding.right;
const chartPlotHeight = chartHeight - chartPadding.top - chartPadding.bottom;
const chartPoints = weeklyDistance.map((week, index) => ({
  ...week,
  x:
    chartPadding.left +
    (index / Math.max(weeklyDistance.length - 1, 1)) * chartPlotWidth,
  y:
    chartPadding.top +
    (1 - week.distanceKm / maxWeeklyDistance) * chartPlotHeight,
}));
const chartLinePoints = chartPoints
  .map(point => `${point.x},${point.y}`)
  .join(" ");

const stats = [
  {
    label: "Tổng quãng đường",
    value: `${totalDistance.toFixed(1)} km`,
  },
  {
    label: "Số buổi chạy",
    value: String(activities.length),
  },
  {
    label: "Pace trung bình",
    value: formatPace(averagePace),
  },
  {
    label: "Buổi mới nhất",
    value: latestActivity ? formatDate(latestActivity.startDate) : "-",
  },
];

function formatDate(date: string) {
  return new Intl.DateTimeFormat("vi-VN", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
  }).format(new Date(date));
}

function formatDateTime(date: string) {
  return new Intl.DateTimeFormat("vi-VN", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  }).format(new Date(date));
}

function formatPace(seconds: number | null) {
  if (!seconds) return "-";

  const minutes = Math.floor(seconds / 60);
  const restSeconds = String(seconds % 60).padStart(2, "0");

  return `${minutes}:${restSeconds}/km`;
}

function getRecentWeeklyDistance(source: RunningActivity[]) {
  const latestDate = source[0]?.startDate
    ? new Date(source[0].startDate)
    : new Date();
  const latestMonday = getMonday(latestDate);
  const weekCount = 4;
  const weeks = Array.from({ length: weekCount }, (_, index) => {
    const date = new Date(latestMonday);
    date.setDate(date.getDate() - (weekCount - 1 - index) * 7);
    return {
      key: date.toISOString().slice(0, 10),
      label: `${date.getDate()}/${date.getMonth() + 1}`,
      distanceKm: 0,
    };
  });
  const weeksByKey = new Map(weeks.map(week => [week.key, week]));

  source.forEach(activity => {
    const date = new Date(activity.startDate);
    if (Number.isNaN(date.getTime())) return;

    const key = getMonday(date).toISOString().slice(0, 10);
    const week = weeksByKey.get(key);
    if (!week) return;

    week.distanceKm += activity.distanceKm ?? 0;
  });

  return weeks.map(week => ({
    ...week,
    distanceKm: Math.round(week.distanceKm * 10) / 10,
  }));
}

function getMonday(date: Date) {
  const monday = new Date(date);
  const day = (monday.getDay() + 6) % 7;
  monday.setDate(monday.getDate() - day);
  monday.setHours(0, 0, 0, 0);
  return monday;
}
---

<Layout title="Chạy bộ" description="Nhật ký chạy bộ.">
  <Header />
  <main id="main-content" class="app-layout py-10">
    <section class="pb-8">
      <div
        class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between"
      >
        <h1 class="text-3xl font-semibold sm:text-4xl">
          Chạy bộ {currentYear}
        </h1>

        {
          lastSyncedAt && (
            <p class="text-muted-foreground text-sm whitespace-nowrap">
              Cập nhật: {lastSyncedAt}
            </p>
          )
        }
      </div>
    </section>

    <section
      class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4"
      aria-label="Thống kê chạy bộ"
    >
      {
        stats.map(stat => (
          <div class="border-border bg-muted/20 rounded-md border px-4 py-4">
            <p class="text-muted-foreground text-sm">{stat.label}</p>
            <p class="mt-2 text-2xl font-semibold">{stat.value}</p>
          </div>
        ))
      }
    </section>

    {
      weeklyDistance.length > 0 && (
        <section class="border-border mt-10 border-t pt-8">
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="text-xl font-semibold">4 tuần gần đây</h2>
            <p class="text-muted-foreground text-sm">km mỗi tuần</p>
          </div>
          <svg
            class="mt-6 h-auto w-full overflow-visible"
            viewBox={`0 0 ${chartWidth} ${chartHeight}`}
            role="img"
            aria-labelledby="weekly-distance-chart-title"
          >
            <title id="weekly-distance-chart-title">
              Quãng đường chạy trong 4 tuần gần đây
            </title>
            <line
              x1={chartPadding.left}
              y1={chartPadding.top + chartPlotHeight}
              x2={chartWidth - chartPadding.right}
              y2={chartPadding.top + chartPlotHeight}
              class="stroke-border"
              stroke-width="1"
            />
            <polyline
              points={chartLinePoints}
              class="stroke-accent"
              fill="none"
              stroke-width="4"
              stroke-linecap="round"
              stroke-linejoin="round"
              vector-effect="non-scaling-stroke"
            />
            {chartPoints.map(point => (
              <g>
                <circle
                  cx={point.x}
                  cy={point.y}
                  r="6"
                  class="fill-background stroke-accent"
                  stroke-width="4"
                  vector-effect="non-scaling-stroke"
                >
                  <title>{`${point.label}: ${point.distanceKm} km`}</title>
                </circle>
                <text
                  x={point.x}
                  y={point.y - 14}
                  class="fill-muted-foreground"
                  font-size="14"
                  text-anchor="middle"
                >
                  {point.distanceKm}
                </text>
                <text
                  x={point.x}
                  y={chartHeight - 10}
                  class="fill-muted-foreground"
                  font-size="14"
                  text-anchor="middle"
                >
                  {point.label}
                </text>
              </g>
            ))}
          </svg>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>
