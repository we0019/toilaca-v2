---
import { Image } from "astro:assets";
import IconRss from "@/assets/icons/IconRss.svg";
import avatar from "@/assets/images/avatar.jpg";
import Socials from "@/components/Socials.astro";
import { getSitePath } from "@/utils/withBase";
import { ui } from "@/ui";
import config from "@/config";

const { socials } = config;

const t = ui;
---

<section id="hero" class="border-border border-b py-8">
  <div
    class="flex flex-col items-center gap-6 text-center sm:flex-row sm:gap-8 sm:text-left"
  >
    <a
      href={getSitePath("about")}
      class="focus-outline group block size-28 shrink-0 overflow-hidden rounded-full sm:size-36"
      aria-label="Xem trang giới thiệu về tác giả"
    >
      <Image
        src={avatar}
        width={144}
        height={144}
        densities={[1.5, 2]}
        alt="Ảnh đại diện của tác giả blog Tôi la cà"
        class="size-full rounded-full object-cover transition-transform duration-200 group-hover:scale-105"
        priority
      />
    </a>

    <div class="flex flex-col items-center sm:items-start">
      <div class="flex items-center justify-center gap-2 sm:justify-start">
        <h1 class="text-4xl font-bold sm:text-5xl">Tôi la cà.</h1>
        <a
          target="_blank"
          href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
          class="inline-block"
          aria-label="RSS Feed"
          title="RSS Feed"
        >
          <IconRss
            width={20}
            height={20}
            class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
          />
          <span class="sr-only">RSS Feed</span>
        </a>
      </div>

      <p class="mt-4">
        Một chiếc blog nhỏ về cuộc sống, công việc, chạy bộ và những dự án của
        mình.
        <br />
        Viết để lưu lại những điều mình đã học, đã làm và đã trải nghiệm.
      </p>

      {
        socials.length > 0 && (
          <div class="mt-4 flex flex-col items-center sm:flex-row">
            <div class="mb-1 whitespace-nowrap sm:me-2 sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </div>
  </div>
</section>
